{
  "name": "sentinelai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.11",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm run env:init && npm run infra:up && npm run verify",
    "env:init": "tsx scripts/init-env.ts",
    "infra:up": "docker compose up -d --wait postgres redis",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "infra:logs": "docker compose logs -f",
    "stack:up": "docker compose up -d --build --wait",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f",
    "verify": "npm run verify:env && npm run verify:db && npm run verify:redis",
    "verify:env": "tsx scripts/check-env.ts",
    "verify:db": "tsx scripts/check-db.ts",
    "verify:redis": "tsx scripts/check-redis.ts",
    "dev:web": "npm run dev --workspace web",
    "build:web": "npm run build --workspace web",
    "lint:web": "npm run lint --workspace web",
    "typecheck:web": "npm run typecheck --workspace web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run typecheck:web && npm run typecheck:api && npm run lint && npm run lint:web && npm run format:check",
    "dev:api": "npm run dev --workspace api",
    "dev:worker": "npm run dev:worker --workspace api",
    "build:api": "npm run build --workspace api",
    "start:api": "npm run start --workspace api",
    "start:worker": "npm run start:worker --workspace api",
    "lint:api": "npm run lint --workspace api",
    "typecheck:api": "npm run typecheck --workspace api",
    "db:generate": "npm run db:generate --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace api",
    "db:studio": "npm run db:studio --workspace api",
    "test": "npm run test --workspace api",
    "test:unit": "npm run test:unit --workspace api",
    "test:integration": "npm run test:integration --workspace api",
    "test:coverage": "npm run test:coverage --workspace api",
    "verify:persistence": "npm run verify:persistence --workspace api",
    "verify:queue": "npm run verify:queue --workspace api"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
